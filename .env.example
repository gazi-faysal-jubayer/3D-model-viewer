# Autodesk Platform Services credentials
# Get these from https://aps.autodesk.com/
APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here

# Optional: Bucket name (defaults to {client_id}-basic-app)
# APS_BUCKET=my-bucket-name

# Optional: Server port (defaults to 8080)
# PORT=3000